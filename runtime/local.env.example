# 老友 — 本机运行配置
#
# 用法：把本文件复制成同目录下的 local.env，再按需取消注释填写。
# 该文件在 .gitignore 里（runtime/*），不会被提交，可以安全放密钥。
#
# 两个启动器都会读这份文件，规则一致：
#   scripts/start.ps1   （官方路径，需要项目自带 PostgreSQL）
#   启动老友-预览.cmd   （SQLite 快速预览模式，本机当前用这个）
#
# 解析规则很窄，不是完整 dotenv：
# 只识别 ^([A-Z_]+)=(.*)$ 的行：不要加引号、不要写 export、
# 不要留行尾注释，否则整行被静默跳过且不报错。
#
# 例外：预览模式会强制用 tmp/preview.db，local.env 里的 DATABASE_URL
# 在那里不生效（并在启动横幅里提示）。

# ---- 数据库（必填）----
# PostgreSQL 连接串；显式填 sqlite:/// 可进本地预览模式。
# DATABASE_URL=postgresql+psycopg://laoyou:<password>@127.0.0.1:55432/laoyou

# ---- 方言语音识别（可选，二选一或都配）----
# 通义千问：方言识别 + 归一化为普通话书面语。方言场景推荐。
# QWEN_API_KEY=
# QWEN_ASR_URL=
# QWEN_ASR_MODEL=qwen-omni-turbo

# 讯飞：普通话延迟更低。方言需在控制台单独添加方言条目。
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=

# ---- 跨网络通话的中继（可选）----
# 电脑与手机不在同一网络时，只有公共 STUN 往往打不通，需要 TURN 中继。
# 在 Cloudflare 控制台 Realtime → TURN 创建 Key，把 Key 与配套 Token 填这里，
# 后端会按 TTL 换短期凭据下发给浏览器（Key 本身不出后端）。
# 详见 doc/01-开发者文档.md 15.7「跨网络访问」。
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# LAOYOU_TURN_TTL=3600

# 不想用 Cloudflare 时，用自建 coturn 等静态 ICE 列表（JSON 数组），
# 与上面同时配置时优先 Cloudflare。
# LAOYOU_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]

# ---- 其他 ----
# LAOYOU_SEED_DEMO=0
# LAOYOU_CORS_ORIGINS=*

# ---- 药盒识别（拍照自动填用药提醒）----
# 多模态大模型。密钥只在后端使用，不配则识别接口返回 503，其余功能不受影响。
# LAOYOU_VLM_KEY=
# LAOYOU_VLM_MODEL=glm-5v-turbo
# LAOYOU_VLM_URL=https://copilot.tencent.com/v2/chat/completions
# LAOYOU_VLM_TIMEOUT=30
